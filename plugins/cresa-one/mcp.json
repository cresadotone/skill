{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cresa-one": {
      "type": "streamable-http",
      "url": "https://mcp.cresa.one/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "cresa:read",
              "cresa:write"
            ]
          }
        }
      }
    }
  }
}
